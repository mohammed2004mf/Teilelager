# Diese Datei kopieren und als ".env.local" speichern, dann die Werte eintragen.
# Zu finden in Supabase unter: Project Settings → API (bzw. "Data API" / "API Keys")

# Project URL, z. B. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# "anon" / "publishable" Key (der öffentliche Schlüssel, NICHT der "service_role"/"secret" Key!)
VITE_SUPABASE_ANON_KEY=

# Die zwei Benutzer: Anzeigename und E-Mail-Adresse, mit der der Benutzer in Supabase angelegt wurde.
# Format: Name:E-Mail,Name:E-Mail
VITE_BENUTZER=Mahmud:mahmud@teilelager.app,Kravan:kravan@teilelager.app
